# =============================================================================
# SilvaEngine Gateway — Test Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values for integration testing:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env with real credentials to version control.
# =============================================================================

# ── Auth ──────────────────────────────────────────────────────────────────────
GATEWAY_AUTH_PROVIDER=local          # local | cognito
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP=15                  # Token expiry in minutes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# ADMIN_STATIC_TOKEN=                 # Optional: pre-generated permanent token

# ── Local user file (optional, local auth only) ──────────────────────────────
# LOCAL_USER_FILE=                    # Path to users.json

# ── AWS Cognito (only if GATEWAY_AUTH_PROVIDER=cognito) ───────────────────────
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
# COGNITO_APP_SECRET=
# COGNITO_JWKS_URL=                  # Optional: auto-derived from pool ID

# ── Gateway server ───────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8765
GATEWAY_WORKERS=1

# CORS allowed origins (comma-separated). "*" (or unset) = allow any origin
# WITHOUT credentials. Set explicit origins to also allow credentials/cookies,
# e.g. GATEWAY_CORS_ORIGINS=http://localhost:5999,http://localhost:3000
GATEWAY_CORS_ORIGINS=*

# ── Performance tuning ───────────────────────────────────────────────────────
# Thread pool size for synchronous dispatch execution (WebSocket handlers, etc.)
GATEWAY_DISPATCH_WORKERS=32

# ── Route manifest (optional overrides) ──────────────────────────────────────
# GATEWAY_ROUTES_CONFIG_PATH=        # Path to custom routes.yaml

# ── Shared-store backends (required when GATEWAY_WORKERS > 1) ─────────────────
GATEWAY_TASK_BACKEND=memory          # memory | dynamodb
# GATEWAY_TASK_TABLE=silvaengine-gateway-tasks       # DynamoDB hash key: task_id
GATEWAY_TASK_TTL=3600                # Task state TTL (seconds)
GATEWAY_RATE_LIMIT_BACKEND=memory    # memory | dynamodb
GATEWAY_RATE_LIMIT=100               # Max requests per window (default: 100)
GATEWAY_RATE_WINDOW=60               # Rate-limit window in seconds (default: 60)
# GATEWAY_RATE_LIMIT_TABLE=silvaengine-gateway-ratelimit  # hash key: rl_key
# NOTE: SSE with workers>1 needs sticky sessions; cross-worker broadcast needs
# a pub/sub backplane (not provided). See docs/gateway_setup.md.

# ── DynamoDB ─────────────────────────────────────────────────────────────────
initialize_tables=1                  # Set to 1 to auto-create tables on startup

# ── AWS (shared with KGE core) ───────────────────────────────────────────────
region_name=us-west-2
aws_access_key_id=                   # Your AWS access key
aws_secret_access_key=               # Your AWS secret key

# ── Neo4j ─────────────────────────────────────────────────────────────────────
# IMPORTANT: neo4j_password MUST match your local Neo4j password.
# Test with: python -c "from neo4j import GraphDatabase; \
#   GraphDatabase.driver('bolt://localhost:7687',auth=('neo4j','YOUR_PASSWORD'))\
#   .verify_connectivity(); print('OK')"
neo4j_uri=bolt://localhost:7687
neo4j_username=neo4j
neo4j_password=                      # <-- fill in your actual Neo4j password
neo4j_database=neo4j

# ── LLM ──────────────────────────────────────────────────────────────────────
llm_type=openai
llm_name=gpt-4o
openai_api_key=                     # Your OpenAI API key
# openai_base_url=                  # Optional: custom endpoint (Azure, proxy, etc.)
# anthropic_api_key=                # Your Anthropic API key
# anthropic_base_url=               # Optional: custom endpoint
# ollama_host=http://localhost:11434

# ── Embeddings ───────────────────────────────────────────────────────────────
# embedding_provider=                # Defaults to llm_type if not set
embedding_model=text-embedding-3-small

# Performance tuning — agent cache pre-warming
# Comma-separated agent UUIDs to pre-warm at startup (empty = auto-discover all)
# PREWARM_AGENT_UUIDS=agent-1780802783-70468776

# ── Cache ─────────────────────────────────────────────────────────────────────
cache_enabled=0                      # 1 = enable query caching; 0 = off

# Redis cache (optional). The cache layer (HybridCacheEngine) uses Redis as the
# primary store with a disk-cache fallback, read DIRECTLY from the environment
# (not via settings.yaml). Redis is used only when cache_enabled=1 AND REDIS_HOST
# is set; otherwise it falls back to disk. Leave REDIS_HOST unset for disk-only.
# REDIS_HOST=localhost
# REDIS_PORT=6379                     # default 6379
# REDIS_DB=0                          # default 0
# REDIS_PASSWORD=                     # optional
# REDIS_DB_<CACHE_NAME>=1             # optional per-cache DB override (name uppercased)

# ── Dual-Backend Selection (forwarded to KGE Config) ─────────────────────────
# db_backend: "dynamodb" (default) or "postgresql"
# When set to "postgresql", the PG_* keys below are used and DynamoDB table
# creation is skipped. Neo4j is always required regardless of backend.
# AWS credentials are still needed for Lambda dispatch and S3 file parsing.
db_backend=dynamodb

# PostgreSQL connection (used when db_backend=postgresql)
# Either DATABASE_URL or the PG_* keys below. When DATABASE_URL is set it wins
# (used by Alembic migrations; runtime Config uses individual PG_* keys).
# DATABASE_URL=postgresql+psycopg2://silvaengine:silvaengine@localhost:5432/silvaengine
PG_HOST=localhost
PG_PORT=5432
PG_USER=silvaengine
PG_PASSWORD=silvaengine
PG_DB=silvaengine
# Per-module PG table prefixes — each module gets its own prefix to avoid
# table-name collisions in shared databases.
KGE_PG_TABLE_PREFIX=kge_
RFQ_PG_TABLE_PREFIX=rfq_
AME_PG_TABLE_PREFIX=ame_
# Marketing Engine scheduler tenant context. The scheduler runs outside HTTP
# requests, so it cannot derive the tenant from the Part-Id header. For
# multiple tenants, list them comma-separated (ME_SCHEDULER_PARTITION_KEYS);
# for a single tenant, use ME_SCHEDULER_PARTITION_KEY or
# ME_SCHEDULER_ENDPOINT_ID + ME_SCHEDULER_PART_ID. Without any of these,
# scheduler ticks log "partition_key is required" and skip their work.
#ME_SCHEDULER_PARTITION_KEYS=gpt#nestaging,clientB#main
#ME_SCHEDULER_PARTITION_KEY=gpt#nestaging
#ME_SCHEDULER_ENDPOINT_ID=gpt
#ME_SCHEDULER_PART_ID=nestaging
ACE_PG_TABLE_PREFIX=ace_
AACE_PG_TABLE_PREFIX=aace_
# Persist flow_snippet flow_context as XML so agent instructions render the
# flow as XML (not raw JSON). Set to "false" to keep JSON.
AACE_XML_CONVERT=true
CE_PG_TABLE_PREFIX=ce_
SCE_PG_TABLE_PREFIX=sce_

# ── Default search query (used by call_search.py when --query is omitted) ────
# AI Marketing Engine GraphQL route through silvaengine_gateway
# POST /{endpoint_id}/ai_marketing_graphql with Part-Id header
DEFAULT_SEARCH_QUERY=FLIGHT-CDG-JFK-BUS
DEFAULT_SEARCH_MODE=text2cypher

# ── RFQ Engine ─────────────────────────────────────────────────────────────
# Used by call_inquire_catalog.py when --namespace / --query-text are omitted
INQUIRE_NAMESPACE=DEFAULT
INQUIRE_QUERY_TEXT=long haul international flights with meals included

# ── Cross-Module Routing ──────────────────────────────────────────────────
# functs_on_local: how modules call each other in-process.
# Override module/class names only if you renamed packages.
#FUNCTS_KGE_MODULE=knowledge_graph_engine
#FUNCTS_KGE_CLASS=KnowledgeGraphEngine
#FUNCTS_RFQ_MODULE=rfq_engine
#FUNCTS_RFQ_CLASS=RFQEngine
#FUNCTS_MCP_MODULE=mcp_daemon_engine
#FUNCTS_MCP_CLASS=MCPDaemonEngine

# ── MCP Daemon Engine (driven through the gateway) ────────────────────────
# These mirror ../mcp_daemon_engine/mcp_daemon_engine/tests/.env. The gateway
# forwards them to mcp_daemon_engine.handlers.config:Config.
MCP_TRANSPORT=sse                    # Forwarded as Config `transport`

# MCP tool-package staging (generateMcpPackageUploadUrl / processMcpPackage)
FUNCT_BUCKET_NAME=                   # S3 bucket for MCP tool packages
FUNCT_ZIP_PATH=/tmp/funct_zips       # Local zip staging path
FUNCT_EXTRACT_PATH=/tmp/functs       # Local package extraction path (must be importable)
# MCP_TEST_PACKAGE_ZIP=              # Path to a pre-built package ZIP for upload tests

# Git module installation (installMcpPackageFromGit)
#GIT_INSTALL_PATH=/tmp/packages      # Parent dir for installed Git packages
#GIT_INSTALL_TIMEOUT=300             # Max seconds for one install operation
GIT_ALLOWED_HOSTS=github.com         # Comma-separated Git host allowlist
# Auth is determined by the gitUrl scheme — set only the one you use:
#   https:// URLs -> GIT_TOKEN (x-access-token basic auth)
#   git@host:... or ssh:// URLs -> SSH key (system ~/.ssh, ssh-agent, or
#     GIT_SSH_KEY below). GIT_TOKEN is ignored for SSH URLs and vice versa.
#GIT_TOKEN=                          # Token for private repos (never persisted/logged)
#GIT_SSH_KEY=                        # Private SSH key material for git+ssh URLs.
                                     # Multi-line PEM with \n escapes, e.g.
                                     # GIT_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
                                     # Written to a 0600 temp file and passed to git via
                                     # GIT_SSH_COMMAND. Leave unset to use the system SSH
                                     # setup (~/.ssh, ssh-agent) — preferred in Docker images
                                     # that bake a deploy key.
#GIT_REQUIRE_REF=true                # Require branch/tag/commit (default true)
#GIT_REFRESH_POLICY=manual           # manual | on_startup | on_runtime_miss
#GIT_REFRESH_TTL=3600                # Min seconds between remote version checks
#GIT_VERSION_STRATEGY=ref            # ref | latest_tag
#GIT_TAG_PATTERN=                    # Regex for tags when version_strategy=latest_tag

# Legacy S3 package upload compatibility (kept during Git migration).
# Effective only when FUNCT_BUCKET_NAME is set.
#ENABLE_S3_PACKAGE_UPLOAD=true

# External MCP proxy tests (syncExternalMcpServer / external tool calls)
# MCP_TEST_EXTERNAL_BASE_URL=        # Reachable HTTP MCP server (JSON-RPC over POST)
# MCP_TEST_EXTERNAL_SERVER_NAME=test_external   # ^[A-Za-z][A-Za-z0-9_]*$
# MCP_TEST_EXTERNAL_BEARER=          # Bearer token forwarded upstream
# MCP_TEST_EXTERNAL_NAME_PREFIX=     # Prefix to avoid local name collisions
# MCP_TEST_EXTERNAL_TOOL_NAME=search_product   # Local tool name to invoke
# MCP_TEST_EXTERNAL_TOOL_QUERY=shirt # Free-text "query" argument

# ---------------------------------------------------------------------------
# Default test data values
# ---------------------------------------------------------------------------
# DEFAULT_AGENT_UUID=
# DEFAULT_USER_ID=test-user
# DEFAULT_UPDATED_BY=test-user
# NOTE: cache_enabled is defined once in the Cache section above — do not
# redefine it here (load_dotenv(override=True) lets a later definition win).

# ── AI Agent Core Engine (WebSocket streaming) ───────────────────────────────
# These are forwarded to ai_agent_core_engine.handlers.config:Config.
# The internal_mcp block is required for _get_agent() to fetch agent
# MCP server config at runtime.
#
# internal_mcp_base_url is the gateway base URL only. build_setting_from_env
# derives the MCP route as {internal_mcp_base_url}/{endpoint_id}/mcp. The
# ai_agent_core adds Part-Id from the active request tenant.
# If internal_mcp_bearer_token is blank, local auth can generate one from
# internal_mcp_token_username / internal_mcp_token_password. For non-local auth,
# the token is fetched from {internal_mcp_base_url}/auth/token.
# x-api-key is forwarded as a header to the MCP server.
#
# internal_mcp_base_url=http://localhost:8765
# internal_mcp_bearer_token=
# internal_mcp_token_username=admin
# internal_mcp_token_password=admin123
# x-api-key=

# ── Hermes Agent A2A Bridge ────────────────────────────────────────────────
# These are forwarded to a2a_daemon_engine.handlers.config:Config so the
# Phase 10 bridge can route A2A tasks to a Hermes Agent API Server instance
# via HTTP + SSE instead of in-process LLM calls.
#
# Prerequisites:
#   - Hermes API Server running (API_SERVER_ENABLED=true, API_SERVER_KEY set)
#   - a2a_daemon_engine installed and importable
#   - hermes-agent registered in the DB with metadata containing module_name,
#     class_name, hermes_api_url, hermes_api_key, hermes_model
#     (use register_hermes_agent.py or a direct SQL insert)
#
# The agent's handler config (module_name, class_name, hermes_* connection
# details) should be stored in the a2a_agent record's metadata JSON in the
# database.  The env vars below are global fallbacks only — they apply when
# the agent record has no metadata or the agent is not found in the DB.
#
# Config resolution priority:
#   1. Agent metadata (DB)  — highest, per-agent routing
#   2. Setting dict          — fallback
#   3. Config class (env vars below) — lowest, global defaults
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=                        # Bearer token for Hermes API Server
HERMES_MODEL=hermes-agent
HERMES_STREAM_TIMEOUT=300              # SSE stream timeout in seconds

# ── A2A bridge — handler type default ─────────────────────────────────────
# A2A_AI_AGENT_TYPE is a shorthand that maps to module_name / class_name via
# AGENT_TYPE_MAP (hermes, core_engine, openclaw, llm). Custom handlers use
# module_name / class_name in per-agent DB metadata instead.
# Per-agent metadata always wins; this is the global default when metadata
# is empty.
#A2A_AI_AGENT_TYPE=hermes
A2A_DEFAULT_AGENT_UUID=a2a-default-agent
A2A_STREAM_TIMEOUT=120.0
A2A_STREAMING_ENABLED=true

# ── Core Engine gateway bridge ────────────────────────────────────────────
# Forwarded to a2a_daemon_engine.handlers.config:Config so the Phase 10
# bridge can route A2A tasks to ai_agent_core_engine via silvaengine_gateway
# using GraphQL (non-streaming) and WebSocket (streaming) transports.
# CORE_ENGINE_AGENT_UUID is auto-mapped from DEFAULT_AGENT_UUID — set
# DEFAULT_AGENT_UUID once and the a2a daemon picks it up automatically.
#CORE_ENGINE_GRAPHQL_URL=http://localhost:8765
#CORE_ENGINE_WS_URL=ws://localhost:8765
#CORE_ENGINE_TOKEN=                     # JWT token for gateway auth
# CORE_ENGINE_AGENT_UUID is auto-mapped from DEFAULT_AGENT_UUID — no need to set separately
#CORE_ENGINE_UPDATED_BY=a2a-daemon
#CORE_ENGINE_STREAM_TIMEOUT=120

# ── LLM Engine API key encryption ─────────────────────────────
# Fernet key for encrypting API key secrets. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANYAN_ENCRYPTION_KEY=
